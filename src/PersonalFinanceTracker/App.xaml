<Application x:Class="PersonalFinanceTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PersonalFinanceTracker"
             xmlns:views="clr-namespace:PersonalFinanceTracker.Views"
             xmlns:viewmodels="clr-namespace:PersonalFinanceTracker.ViewModels">
    <Application.Resources>
        <DataTemplate DataType="{x:Type viewmodels:LoginVM}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:RegistrationVM}">
            <views:RegistrationView/>
        </DataTemplate>
        <!--<DataTemplate DataType="{x:Type viewmodels:AddTransactionViewModel}">
            <views:TransactionView/>
        </DataTemplate>-->
        <DataTemplate DataType="{x:Type viewmodels:TransactionFormVM}">
            <views:TransactionView/>
        </DataTemplate>
        <!--<DataTemplate DataType="{x:Type viewmodels:TransactionHistoryViewModel}">
            <views:TransactionHistoryView/>
        </DataTemplate>-->
    </Application.Resources>

</Application>

