<UserControl x:Class="PersonalFinanceTracker.Views.RegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:PersonalFinanceTracker.Views"
             xmlns:behaviors="clr-namespace:PersonalFinanceTracker.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <StackPanel VerticalAlignment="Center"
                Margin="100 0 100 100">

        <!--Title-->
        <TextBlock Text="Registration" 
                       FontSize="20" FontWeight="Bold"/>

        <Separator Margin="0 10 0 10"/>

        <!--Username and Password-->
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Username : "
                           VerticalAlignment="Center"
                           Margin="5,5"
                           FontSize="14"/>

            <TextBox Grid.Row="0" Grid.Column="1" 
                         Text="{Binding Username, Mode=TwoWay}"
                         Margin="10,5"
                         FontSize="14"
                         />


            <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="Password : " 
                           VerticalAlignment="Center"
                           Margin="5,5"
                           FontSize="14"/>

            <PasswordBox Grid.Row="1" Grid.Column="1" 
                             Margin="10,5"
                             FontSize="14">
                <i:Interaction.Behaviors>
                    <behaviors:BindablePassowdBehavior BindablePassword="{Binding Password, Mode=TwoWay}"/>
                </i:Interaction.Behaviors>
            </PasswordBox>

            <TextBlock Grid.Row="2" Grid.Column="0" 
                           Text="Confirm Password : " 
                           VerticalAlignment="Center"
                           Margin="5,5"
                           FontSize="14"/>

            <PasswordBox Grid.Row="2" Grid.Column="1" 
                             Margin="10,5"
                             FontSize="14">
                <i:Interaction.Behaviors>
                    <behaviors:BindablePassowdBehavior BindablePassword="{Binding ConfirmPassword, Mode=TwoWay}"/>
                </i:Interaction.Behaviors>
            </PasswordBox>


            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        </Grid>

        <!--Status Message-->
        <TextBlock Text="{Binding StatusMessage}"
                       Foreground="Red" FontSize="12"
                       Visibility="{Binding StatusMessageVisibility}"/>

        <!--Buttons-->
        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

            <Button Content="Register" 
                        Command="{Binding RegisterCommand}"
                        Margin="10"
                        Width="80"/>

            <Button Content="Cancel" 
                        Command="{Binding CancelCommand}"
                        Margin="10"
                        Width="80"/>

        </StackPanel>

    </StackPanel>
</UserControl>
