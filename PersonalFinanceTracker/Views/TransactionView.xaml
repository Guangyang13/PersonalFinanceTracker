<UserControl x:Class="PersonalFinanceTracker.Views.TransactionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:PersonalFinanceTracker.Views"
             xmlns:behaviors="clr-namespace:PersonalFinanceTracker.Behaviors"
             xmlns:helpers="clr-namespace:PersonalFinanceTracker.Helpers.UI"
             xmlns:converters="clr-namespace:PersonalFinanceTracker.Converters"
             xmlns:main="clr-namespace:PersonalFinanceTracker"
             x:Name="TransactionViewName"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding GetTransactionsCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    
    <UserControl.Resources>
        <ObjectDataProvider x:Key="TransactionTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="main:TransactionType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <converters:StringToDecimalConverter x:Key="StringToDecimalConverter"/>
        <converters:EmptyStringToPlaceholderTextConverter x:Key="EmptyStringToPlaceholderTextConverter"/>
        <converters:BooleanInverterConverter x:Key="BooleanInverterConverter"/>
    </UserControl.Resources>
    
    <Grid ShowGridLines="True">

        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>-->

        <Button Grid.ColumnSpan="2" 
                Content="{Binding Username}"
                HorizontalAlignment="Right"
                Margin="5" Width="80" Height="25"
                Command="{Binding LogoutCommand}"/>

        <StackPanel Grid.Row="1" Grid.Column="0" 
                    VerticalAlignment="Center"
                    Margin="20 0 20 0" >

            <!--Title-->
            <TextBlock Text="Transaction" 
                       FontSize="20" FontWeight="Bold"/>

            <Separator Margin="0 10 0 10"/>

            <!--Transaction Properties-->
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Transaction Type : "
                           VerticalAlignment="Center"
                           Margin="5,5"
                           FontSize="14"/>

                <ComboBox Grid.Row="0" Grid.Column="1" 
                          ItemsSource="{Binding Source={StaticResource TransactionTypes}}" 
                          SelectedItem="{Binding Type}" 
                          Margin="10,5"
                          FontSize="14"
                          IsEnabled="{Binding IsEditing}"/>


                <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="Date : " 
                           VerticalAlignment="Center"
                           Margin="5,5"
                           FontSize="14"/>

                <DatePicker Grid.Row="1" Grid.Column="1" 
                            SelectedDate="{Binding Date}"
                            Margin="10,5"
                            FontSize="14"
                            IsEnabled="{Binding IsEditing}"/>
                
                <TextBlock Grid.Row="2" Grid.Column="0" 
                           Text="Category : " 
                           VerticalAlignment="Center"
                           Margin="5,5"
                           FontSize="14"/>

                <TextBox Grid.Row="2" Grid.Column="1" 
                         Text="{Binding Category, Mode=TwoWay}"
                         Margin="10,5"
                         FontSize="14"
                         IsEnabled="{Binding IsEditing}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" 
                           Text="Amount : " 
                           VerticalAlignment="Center"
                           Margin="5,5"
                           FontSize="14"/>


                <TextBox Grid.Row="3" Grid.Column="1" 
                         Text="{Binding Amount, Mode=TwoWay}"
                         Margin="10,5"
                         FontSize="14"
                         IsEnabled="{Binding IsEditing}">
                    
                    <i:Interaction.Behaviors>
                        <behaviors:NumericOnlyBehavior/>
                    </i:Interaction.Behaviors>

                </TextBox>
                
                <TextBlock Grid.Row="4" Grid.Column="0" 
                           Text="Description : " 
                           VerticalAlignment="Center"
                           Margin="5,5"
                           FontSize="14">
                </TextBlock>

                <TextBox Grid.Row="4" Grid.Column="1" 
                         Text="{Binding Description, Mode=TwoWay}"
                         Margin="10,5"
                         FontSize="14"
                         IsEnabled="{Binding IsEditing}"/>


                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
            </Grid>

            <!--Status Message-->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="Red" FontSize="12"
                       Visibility="{Binding StatusMessageVisibility}"/>

            <!--Buttons-->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="Create" 
                        Command="{Binding CreateCommand}"
                        Margin="5"
                        Width="80"
                        IsEnabled="{Binding IsEditing, Converter={StaticResource BooleanInverterConverter}}"/>

                <Button Content="Update" 
                        Command="{Binding UpdateCommand}"
                        Margin="5"
                        Width="80"
                        IsEnabled="{Binding IsUpdateEnabled}"/>
                
                <Button Content="Apply" 
                        Command="{Binding ApplyCommand}"
                        Margin="5"
                        Width="80"
                        IsEnabled="{Binding IsEditing}"/>
                
                <Button Content="Cancel" 
                        Command="{Binding CancelCommand}"
                        Margin="5"
                        Width="80"
                        IsEnabled="{Binding IsEditing}"/>

            </StackPanel>

        </StackPanel>

        <DataGrid Grid.Row="2" Grid.Column="1"
                  ItemsSource="{Binding Transactions}" 
                  SelectedItem="{Binding SelectedTransaction}"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  AutoGenerateColumns="False" Margin="10">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                <DataGridTextColumn Header="Amount (RM)" Binding="{Binding Amount}" Width="*" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />

                <!-- Delete Button Column -->
                <DataGridTemplateColumn Header="Actions" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete" 
                                    Command="{Binding DataContext.DeleteTransactionCommand, 
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Sync" Binding="{Binding IsSynced}" Width="*" />

            </DataGrid.Columns>
        </DataGrid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

    </Grid>
</UserControl>
